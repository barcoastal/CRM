generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ AUTH ============

model User {
  id                String    @id @default(cuid())
  sfId              String?   @unique // Salesforce 18-char User ID, populated by backfill-user-sfid.ts
  name              String
  email             String    @unique
  passwordHash      String
  mustResetPassword Boolean   @default(false) // set true on bulk import; cleared after user picks a new password
  role              String    @default("SALES_REP") // LEGACY string role — replaced by profileId in Phase 2
  avatar            String?
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Phase 1 access model
  profileId       String?
  profile         Profile?            @relation(fields: [profileId], references: [id])
  hierarchyRoleId String?
  hierarchyRole   Role?               @relation("UserRole", fields: [hierarchyRoleId], references: [id])
  managerId       String?
  manager         User?               @relation("UserManager", fields: [managerId], references: [id])
  reports         User[]              @relation("UserManager")
  permissionSets  UserPermissionSet[]
  groupMembers    GroupMember[]
  auditEntries    AuditLog[]
  appLogs         ApplicationLog[]

  leads                     Lead[]
  calls                     Call[]
  campaigns                 CampaignAgent[]
  callFeedbacks             CallFeedback[]
  assignedClients           Client[]                        @relation("ClientNegotiator")
  negotiations              Negotiation[]
  uploadedDocuments         Document[]
  opportunities             Opportunity[]                   @relation("OpportunityAssignee")
  ownedAccounts             Account[]                       @relation("AccountOwner")
  ownedContacts             Contact[]                       @relation("ContactOwner")
  programPlansAssigned      ProgramPlan[]                   @relation("ProgramPlanAssignedTo")
  feesCharged               Fee[]                           @relation("FeeChargedBy")
  offersCreated             Offer[]                         @relation("OfferCreatedBy")
  settlementsApproved       Settlement[]                    @relation("SettlementApprovedBy")
  tasksOwned                Task[]                          @relation("TaskOwner")
  eventsOwned               Event[]                         @relation("EventOwner")
  casesOwned                Case[]                          @relation("CaseOwner")
  casesCreated              Case[]                          @relation("CaseCreatedBy")
  casesApproved             Case[]                          @relation("CaseApprover")
  caseComments              CaseComment[]                   @relation("CaseCommentAuthor")
  listViews                 ListView[]                      @relation("ListViewOwner")
  emailsOwned               EmailMessage[]                  @relation("EmailOwner")
  smsOwned                  SmsMessage[]                    @relation("SmsOwner")
  emailTemplates            EmailTemplate[]                 @relation("EmailTemplateAuthor")
  emailAttachmentsUploaded  EmailTemplateAttachment[]       @relation("EmailAttachmentUploader")
  integrationCredentials    IntegrationCredential[]         @relation("IntegrationCredentialAuthor")
  paymentCalcsSaved         LeadPaymentCalculation[]        @relation("PaymentCalcSavedBy")
  leadHistoryChanges        LeadHistory[]                   @relation("LeadHistoryChangedBy")
  leadDebtsCreated          LeadDebt[]                      @relation("LeadDebtCreatedBy")
  oppPaymentCalcsSaved      OpportunityPaymentCalculation[] @relation("OppPaymentCalcSavedBy")
  oppHistoryChanges         OpportunityHistory[]            @relation("OpportunityHistoryChangedBy")
  accountHistoryChanges     AccountHistory[]                @relation("AccountHistoryChangedBy")
  envelopesCreated          Envelope[]                      @relation("EnvelopeCreatedBy")
  envelopeTemplates         EnvelopeTemplate[]              @relation("EnvelopeTemplateCreatedBy")
  suppressionsAdded         SuppressionEntry[]              @relation("SuppressionAddedBy")
  cadenceEnrollments        CadenceEnrollment[]             @relation("CadenceEnrolledBy")
  marketingSources          MarketingSource[]               @relation("MktSourceOwner")
  dashboards                Dashboard[]                     @relation("DashboardCreatedBy")
  reportsCreated            Report[]                        @relation("ReportCreatedBy")
  quotas                    Quota[]                         @relation("QuotaUser")
  approvalProcessesCreated  ApprovalProcess[]               @relation("ApprovalProcessCreatedBy")
  approvalRequestsSubmitted ApprovalRequest[]               @relation("ApprovalRequestSubmittedBy")
  approvalActions           ApprovalAction[]                @relation("ApprovalActionActor")
  massEmailsSent            MassEmail[]                     @relation("MassEmailFromUser")
  massEmailsCreated         MassEmail[]                     @relation("MassEmailCreatedBy")
  notificationsReceived     Notification[]                  @relation("NotificationRecipient")
  notificationsCaused       Notification[]                  @relation("NotificationActor")

  // Chatter (groups + posts + reactions + follows + mentions)
  chatterGroupsOwned ChatterGroup[]    @relation("ChatterGroupOwner")
  chatterMemberships ChatterMember[]   @relation("ChatterMember")
  chatterPosts       ChatterPost[]     @relation("ChatterPostAuthor")
  chatterReactions   ChatterReaction[] @relation("ChatterReactionUser")
  chatterFollows     ChatterFollow[]   @relation("ChatterFollow")

  // Content Library (central Files)
  contentFolders          ContentLibraryFolder[] @relation("ContentFolderOwner")
  contentDocuments        ContentDocument[]      @relation("ContentDocOwner")
  contentVersionsUploaded ContentVersion[]       @relation("ContentVersionUploader")
  contentRecordLinks      ContentRecordLink[]    @relation("ContentRecordLinkedBy")
  contentShareLinks       ContentShareLink[]     @relation("ContentShareCreatedBy")

  // SF-style Path Guidance authoring
  pathGuidances PathGuidance[] @relation("PathGuidanceCreatedBy")

  // SF-style Validation Rules authoring
  validationRulesCreated ValidationRule[] @relation("ValidationRuleCreatedBy")

  // SF-style Object Manager authoring (field labels + page layouts)
  objectFieldLabelsCreated ObjectFieldLabel[] @relation("ObjectFieldLabelCreatedBy")
  pageLayoutsCreated       PageLayout[]       @relation("PageLayoutCreatedBy")

  // SF-style Flow Builder authoring
  flowsCreated Flow[] @relation("FlowCreatedBy")

  // Pardot-style Engagement Sequences + Lead Lists authoring
  engagementSequencesCreated EngagementSequence[] @relation("EngagementSequenceCreatedBy")
  leadListsCreated           LeadList[]           @relation("LeadListCreatedBy")

  // Five9 AgentREST credentials per user — used to log the agent into Five9
  // and trigger click-to-dial on their behalf. Password is encrypted at rest
  // with the FIVE9_AGENT_KEY env var.
  five9Username    String?
  five9PasswordEnc String?
  five9StationId   String?
  five9StationType String? // EMPTY | SOFTPHONE | STATION — picked by user when configuring
  five9Domain      String? // override the global FIVE9_API_BASE_URL per-user if needed

  // Persisted Five9 REST session — shared across Railway instances so a
  // session_start on one pod is visible to a click_to_dial on another.
  // Serialized AgentSession JSON.
  five9SessionJson String?
  five9SessionAt   DateTime?

  // SF "My Personal Information" profile fields. Mirrors Salesforce User
  // standard fields exposed on the personal settings page.
  middleName     String?
  suffix         String?
  alias          String?
  nickname       String?
  title          String?
  companyDisplay String?
  department     String?
  division       String?
  extension      String?
  fax            String?
  mobile         String?
  country        String?
  street         String?
  city           String?
  state          String?
  postalCode     String?
}

// ============ ACCESS CONTROL (SF parity: Role hierarchy, Profile, PermissionSet) ============

model Role {
  id            String   @id @default(cuid())
  name          String   @unique // "VP of Sales"
  developerName String   @unique // "VPofSales"
  parentId      String?
  parent        Role?    @relation("RoleHierarchy", fields: [parentId], references: [id])
  children      Role[]   @relation("RoleHierarchy")
  users         User[]   @relation("UserRole")
  createdAt     DateTime @default(now())
}

model Profile {
  id          String              @id @default(cuid())
  name        String              @unique // "Closer"
  label       String // "Closer"
  description String?
  userType    String              @default("Standard") // Standard | Guest | Integration
  isActive    Boolean             @default(true)
  users       User[]
  permissions ProfilePermission[]
  createdAt   DateTime            @default(now())
}

model PermissionSet {
  id           String                    @id @default(cuid())
  name         String                    @unique // "Export_Reports"
  label        String // "Export Reports"
  description  String?
  isCustom     Boolean                   @default(true)
  permissions  PermissionSetPermission[]
  profileLinks ProfilePermission[]
  userLinks    UserPermissionSet[]
  groupItems   PermissionSetGroupItem[]
  createdAt    DateTime                  @default(now())
}

model PermissionSetGroup {
  id          String                   @id @default(cuid())
  name        String                   @unique // "Closers_PSG"
  label       String // "Closers PSG"
  description String?
  items       PermissionSetGroupItem[]
  createdAt   DateTime                 @default(now())
}

model PermissionSetGroupItem {
  id              String             @id @default(cuid())
  groupId         String
  group           PermissionSetGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  permissionSetId String
  permissionSet   PermissionSet      @relation(fields: [permissionSetId], references: [id], onDelete: Cascade)

  @@unique([groupId, permissionSetId])
}

// A permission KEY (e.g. "Lead.Edit", "Reports.Export") — stored as a string, no separate catalog table.
// PermissionSet → many permission keys via this junction.
model PermissionSetPermission {
  id              String        @id @default(cuid())
  permissionSetId String
  permissionSet   PermissionSet @relation(fields: [permissionSetId], references: [id], onDelete: Cascade)
  key             String // e.g. "Lead.Edit", "Opportunity.Delete", "Reports.Export"

  @@unique([permissionSetId, key])
}

model ProfilePermission {
  id              String        @id @default(cuid())
  profileId       String
  profile         Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  permissionSetId String
  permissionSet   PermissionSet @relation(fields: [permissionSetId], references: [id], onDelete: Cascade)

  @@unique([profileId, permissionSetId])
}

model UserPermissionSet {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionSetId String
  permissionSet   PermissionSet @relation(fields: [permissionSetId], references: [id], onDelete: Cascade)
  assignedAt      DateTime      @default(now())

  @@unique([userId, permissionSetId])
}

// ============ GROUPS / QUEUES (SF Group object, Type=Queue|Role|PublicGroup) ============

model Group {
  id                String            @id @default(cuid())
  name              String // "Closer Pool"
  developerName     String            @unique // "Closer_Pool"
  type              String            @default("PUBLIC_GROUP") // QUEUE | PUBLIC_GROUP | ROLE_GROUP
  description       String?
  // For queues: which sObject types can be assigned (e.g. "Lead", "Case")
  supportedEntities String? // CSV: "Lead,Case"
  members           GroupMember[]
  casesAsOwner      Case[]            @relation("CaseOwnerGroup")
  marketingSources  MarketingSource[] @relation("MktSourceQueue")
  createdAt         DateTime          @default(now())
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([groupId, userId])
}

// ============ AUDIT + LOGGING ============

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  entity    String // "Lead", "Opportunity", "Debt"
  entityId  String
  action    String // CREATE | UPDATE | DELETE
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}

model ApplicationLog {
  id        String   @id @default(cuid())
  level     String   @default("INFO") // DEBUG | INFO | WARN | ERROR
  source    String // "auth", "dialer", "payment-webhook"
  message   String
  payload   Json?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([level])
  @@index([source])
  @@index([createdAt])
}

model AsyncOperation {
  id         String    @id @default(cuid())
  type       String // "bulk-reassign-leads", "draft-batch-run"
  status     String    @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED
  payload    Json?
  result     Json?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status])
  @@index([type])
}

// ============ ACCOUNTS / CONTACTS / CREDITORS (SF parity) ============

model Account {
  id                String    @id @default(cuid())
  sfId              String?   @unique // Salesforce 18-char ID, populated on migration
  sfDataJson        String? // Lossless SF row snapshot
  recordType        String    @default("CLIENT") // CLIENT | CREDITOR | VENDOR | BUSINESS_ACCOUNT | PERSON_ACCOUNT | BUYOUT | OTHER
  name              String // org name OR person full name
  type              String    @default("ORG") // ORG | PERSON
  ein               String?
  ssnLast4          String?
  phone             String?
  email             String?
  website           String?
  industry          String?
  annualRevenue     Float?
  numberOfEmployees Int?
  description       String?
  // billing address
  billingStreet     String?
  billingCity       String?
  billingState      String?
  billingZip        String?
  billingCountry    String?   @default("US")
  // ownership / hierarchy
  ownerId           String?
  owner             User?     @relation("AccountOwner", fields: [ownerId], references: [id])
  parentAccountId   String?
  parentAccount     Account?  @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts     Account[] @relation("AccountHierarchy")
  primaryContactId  String?
  primaryContact    Contact?  @relation("AccountPrimaryContact", fields: [primaryContactId], references: [id])
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // SF Account stage (8 stages — First Payment pending → Active → On Hold → ... → Closed Duplicate)
  stage String @default("First Payment pending")

  // Status pills shown in the highlight strip
  clientStatus      String  @default("Active") // Active | Inactive | Hardship | Cancelled
  processorStatus   String? // Active | Inactive | Suspended
  paymentStatus     String  @default("Active") // Active | NSF | Suspended | Closed
  bankAccountStatus String  @default("Active") // Active | Pending | Closed | Invalid

  // Program dates
  programStartDate  DateTime?
  programEndDate    DateTime?
  businessStartDate DateTime?
  uccFilingDate     DateTime?

  // Cancellation
  cancellationDate   DateTime?
  cancellationReason String?

  // Legal
  legalStatus      String?
  submittedByLegal String?

  // Reschedule
  rescheduleStatus String?
  conversionReason String?

  // Lender info
  loanProvider     String?
  collectionAgency String?

  // External system IDs
  externalSasId         String?
  externalRamId         String? // SF: External_RAM_Id__c (Reliant)
  uccFilingId           String?
  bankAccountSyncStatus String?
  paymentProcessor      String? // RAM | SAS | RELIANT (chosen processor for this account)

  // File Status
  qualifiedStatus        String?
  highUccRisk            Boolean @default(false)
  programCompletionStage Boolean @default(false) // SF Program_Completion_Stage__c
  graduatedStatus        String?

  // Financial Summary
  operatingExpenses           Float?
  netProfit                   Float?
  ebitda                      Float?
  grossProfit                 Float?
  debtPayments                Float?
  buyoutProgramWeeklyPayment  Float?
  buyoutProgramMonthlyPayment Float?
  financialDescription        String?

  // Bank Details (editable on right rail)
  bankName          String?
  bankRoutingNumber String?
  bankAccountNumber String?
  bankAccountType   String? // Checking | Savings

  // Escrow
  escrowBalance  Float     @default(0)
  escrowPulledAt DateTime?
  feePaidInFull  Boolean   @default(false)

  // Health Check
  welcomeCallCompleted Boolean @default(false)
  firstPaymentReceived Boolean @default(false)

  // Total current debt cached for display (computed from active opps)
  currentTotalDebt Float?

  // First contract signed timestamp (set by envelope-trigger on first COMPLETED envelope)
  firstContractSignedDate DateTime?

  contacts           AccountContactRelation[]
  opportunities      Opportunity[]
  creditor           Creditor?
  convertedFromLead  Lead[]                   @relation("LeadConvertedAccount")
  primaryForContact  Contact[]                @relation("PrimaryContactAccount")
  programPlans       ProgramPlan[]
  paymentSummary     PaymentSummary?
  financialSummaries FinancialSummary[]
  tasks              Task[]                   @relation("AccountTasks")
  events             Event[]                  @relation("AccountEvents")
  emails             EmailMessage[]           @relation("AccountEmails")
  sms                SmsMessage[]             @relation("AccountSms")
  cases              Case[]                   @relation("AccountCases")
  history            AccountHistory[]
  documents          Document[]               @relation("AccountDocuments")
  envelopes          Envelope[]               @relation("AccountEnvelopes")
  cadenceEnrollments CadenceEnrollment[]      @relation("AccountCadenceEnrollments")

  @@index([recordType])
  @@index([stage])
}

// ============ DNC / SUPPRESSION LIST (replaces SF SuppressionList + Five9 DNC sync) ============

model SuppressionEntry {
  id        String    @id @default(cuid())
  phone     String    @unique // normalized: digits only, 10 chars (e.g. "5551234567")
  reason    String    @default("Manual") // Manual | LeadArchived | DispositionDNC | Customer | LitigationHold | RegulatoryDNC | Imported
  source    String? // free-text source label (e.g. "CSV: 2026-06-04 cleanup")
  leadId    String?
  lead      Lead?     @relation("LeadSuppressionEntries", fields: [leadId], references: [id])
  addedById String?
  addedBy   User?     @relation("SuppressionAddedBy", fields: [addedById], references: [id])
  notes     String?
  expiresAt DateTime? // optional; null = permanent
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([reason])
  @@index([leadId])
}

// ============ CALL CADENCES (Five9 cadence equivalent) ============

model CallCadence {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  recordType  String   @default("OUTBOUND") // OUTBOUND | NURTURE | FIRST_PAYMENT | WELCOME_CALL | CONTRACT_SIGNED
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps       CadenceStep[]
  enrollments CadenceEnrollment[]

  @@index([recordType])
}

model CadenceStep {
  id              String         @id @default(cuid())
  cadenceId       String
  cadence         CallCadence    @relation(fields: [cadenceId], references: [id], onDelete: Cascade)
  stepOrder       Int // 1-based
  action          String // CALL | EMAIL | SMS | TASK | WAIT
  delayDays       Int            @default(0) // days after the previous step (or enrollment for step 1)
  delayHours      Int            @default(0)
  // Action-specific payloads:
  emailTemplateId String?
  emailTemplate   EmailTemplate? @relation("CadenceStepEmailTemplate", fields: [emailTemplateId], references: [id])
  smsBodyTemplate String?
  callScript      String?
  taskSubject     String?
  // Branching: if previous step's outcome equals this value, jump to stepOrder
  branchOn        String? // e.g. "ANSWERED" | "VOICEMAIL" | null
  branchToStep    Int?

  @@unique([cadenceId, stepOrder])
}

model CadenceEnrollment {
  id               String       @id @default(cuid())
  cadenceId        String
  cadence          CallCadence  @relation(fields: [cadenceId], references: [id], onDelete: Cascade)
  leadId           String?
  lead             Lead?        @relation("LeadCadenceEnrollments", fields: [leadId], references: [id], onDelete: Cascade)
  opportunityId    String?
  opportunity      Opportunity? @relation("OpportunityCadenceEnrollments", fields: [opportunityId], references: [id], onDelete: Cascade)
  accountId        String?
  account          Account?     @relation("AccountCadenceEnrollments", fields: [accountId], references: [id], onDelete: Cascade)
  status           String       @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED | UNENROLLED
  currentStepOrder Int          @default(0) // 0 = not started yet
  nextRunAt        DateTime? // when the runner should look at this enrollment
  lastStepAt       DateTime?
  enrolledById     String?
  enrolledBy       User?        @relation("CadenceEnrolledBy", fields: [enrolledById], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status, nextRunAt])
  @@index([leadId])
  @@index([opportunityId])
  @@index([accountId])
}

// ============ ENVELOPE / E-SIGNATURE (replaces SF DocuSign integration) ============

model Envelope {
  id            String       @id @default(cuid())
  // What this envelope is for
  recordType    String       @default("CONTRACT") // CONTRACT | BANK_CHANGE | DISCLOSURE | AMENDMENT | OTHER
  opportunityId String?
  opportunity   Opportunity? @relation("OpportunityEnvelopes", fields: [opportunityId], references: [id], onDelete: Cascade)
  accountId     String?
  account       Account?     @relation("AccountEnvelopes", fields: [accountId], references: [id], onDelete: Cascade)
  leadId        String?
  lead          Lead?        @relation("LeadEnvelopes", fields: [leadId], references: [id], onDelete: Cascade)

  // Status flow: DRAFT → SENT → VIEWED → SIGNED → COMPLETED
  // VOIDED, DECLINED are terminal states from any non-COMPLETED state
  status String @default("DRAFT") // DRAFT | SENT | VIEWED | SIGNED | COMPLETED | DECLINED | VOIDED

  // Signer info
  signerName  String
  signerEmail String
  signerPhone String?

  // Public-access token for the signing page
  signingToken String @unique @default(cuid())

  // Document
  templateName      String? // e.g. "Engagement Agreement", "Bank Change Authorization"
  documentName      String // display name shown to signer
  documentUrl       String? // pre-signed S3 URL or relative path to PDF
  signedDocumentUrl String? // saved after signing
  pages             Int? // number of pages

  // Signature capture (data URL or relative path to PNG)
  signatureImage     String? // base64 PNG of signature drawn on the public page
  signatureIp        String? // signer's IP at sign time (audit)
  signatureUserAgent String?

  // Lifecycle
  sentAt      DateTime?
  viewedAt    DateTime?
  signedAt    DateTime?
  completedAt DateTime?
  voidedAt    DateTime?
  voidReason  String?
  expiresAt   DateTime?

  // Template the envelope was generated from (optional). For non-template
  // envelopes we still snapshot signature/initial/date boxes below so the
  // signer page does not depend on the template still existing.
  templateId String?
  template   EnvelopeTemplate? @relation("TemplateEnvelopes", fields: [templateId], references: [id])

  signatureBoxes Json @default("[]")
  initialBoxes   Json @default("[]")
  dateBoxes      Json @default("[]")
  // Free-text fields the SIGNER fills in while signing. Same box shape; the
  // `label` is the prompt shown to the signer. Values printed into the PDF.
  textBoxes      Json @default("[]")
  // Auto-filled CRM data fields (box carries `mergeValue` = a merge path).
  // Resolved + printed into the PDF at SEND time; the signer never edits them.
  dataBoxes      Json @default("[]")
  // Checkbox fields the SIGNER ticks (e.g. Checking / Savings). `label` = prompt.
  checkboxBoxes  Json @default("[]")

  // Per-envelope merged PDF (template filled with merge values at send time).
  // Path is relative to envelopeDir() helper. Chunk 3 will overlay signatures
  // and write the signed result to signedDocumentUrl.
  preparedPdfPath String?

  // Last stamping/finish error captured during the signer flow. When the
  // signer hits Finish & Sign and PDF stamping or storage fails, we capture
  // the message here so the dashboard can show the operator what went wrong
  // without leaving the envelope half-completed.
  lastError String?

  // Audit
  createdById String?
  createdBy   User?    @relation("EnvelopeCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events EnvelopeEvent[]

  @@index([opportunityId])
  @@index([accountId])
  @@index([leadId])
  @@index([status])
  @@index([signingToken])
  @@index([templateId])
}

// Reusable PDF template that gets filled with merge data when an Envelope is
// sent. PDFs live on the Railway persistent volume at /data/esign-templates/
// and are referenced here by relative path.
model EnvelopeTemplate {
  id          String  @id @default(cuid())
  name        String
  recordType  String  @default("CONTRACT") // CONTRACT | BANK_CHANGE | DISCLOSURE | AMENDMENT | OTHER
  description String?
  pdfPath     String // relative path on disk under /data/esign-templates/
  pdfFilename String // original upload name for display
  pageCount   Int     @default(1)
  isActive    Boolean @default(true)

  // AcroForm field merges, e.g. { "ClientFirstName": "account.firstName" }.
  // Dot-paths resolve against the merge context built at send time.
  mergeMapping Json @default("{}")

  // Signature box(es): array of { page: 1-based, x, y, width, height, label }.
  // Coordinates are PDF points (72 dpi), origin BOTTOM-LEFT.
  signatureBoxes Json @default("[]")
  initialBoxes   Json @default("[]")
  dateBoxes      Json @default("[]")
  // Free-text fields the SIGNER fills while signing (label = prompt).
  textBoxes      Json @default("[]")
  // Auto-filled CRM data fields (box carries `mergeValue` = a merge path).
  dataBoxes      Json @default("[]")
  // Checkbox fields the SIGNER ticks (label = prompt).
  checkboxBoxes  Json @default("[]")

  createdById String?
  createdBy   User?    @relation("EnvelopeTemplateCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  envelopes Envelope[] @relation("TemplateEnvelopes")

  @@index([recordType])
  @@index([isActive])
}

model EnvelopeEvent {
  id         String   @id @default(cuid())
  envelopeId String
  envelope   Envelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  eventType  String // CREATED | SENT | VIEWED | SIGNED | COMPLETED | VOIDED | DECLINED | REMINDER_SENT
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([envelopeId, createdAt])
}

// ============ ACCOUNT HISTORY (SF Account History parity) ============

model AccountHistory {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  field       String
  oldValue    String?
  newValue    String?
  changedById String?
  changedBy   User?    @relation("AccountHistoryChangedBy", fields: [changedById], references: [id])
  changedAt   DateTime @default(now())

  @@index([accountId, changedAt])
}

model Contact {
  id               String    @id @default(cuid())
  sfId             String?   @unique // Salesforce 18-char ID
  sfDataJson       String? // Lossless SF row snapshot
  firstName        String
  lastName         String
  fullName         String // derived; stored for sort/search
  email            String?
  phone            String?
  mobilePhone      String?
  title            String?
  birthdate        DateTime?
  primaryAccountId String?
  primaryAccount   Account?  @relation("PrimaryContactAccount", fields: [primaryAccountId], references: [id])
  ownerId          String?
  owner            User?     @relation("ContactOwner", fields: [ownerId], references: [id])
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accountRelations      AccountContactRelation[]
  primaryForOpportunity Opportunity[]            @relation("OpportunityPrimaryContact")
  primaryForAccount     Account[]                @relation("AccountPrimaryContact")
  convertedFromLead     Lead[]                   @relation("LeadConvertedContact")
  tasks                 Task[]                   @relation("ContactTasks")
  events                Event[]                  @relation("ContactEvents")
  emails                EmailMessage[]           @relation("ContactEmails")
  sms                   SmsMessage[]             @relation("ContactSms")
  cases                 Case[]                   @relation("ContactCases")
}

model AccountContactRelation {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role      String? // "Owner" | "CFO" | "Authorized Rep" | "Spouse"
  isDirect  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([accountId, contactId])
}

model Creditor {
  id                     String   @id @default(cuid())
  accountId              String   @unique
  account                Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  legalName              String
  collectionsPhone       String?
  collectionsEmail       String?
  settlementPolicy       String?
  averageAcceptedPercent Float?
  totalDebtsHandled      Int      @default(0)
  totalSettledAmount     Float    @default(0)
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  debts Debt[]
}

// ============ LEADS ============

model Lead {
  id              String  @id @default(cuid())
  sfId            String? @unique // Salesforce 18-char ID, populated on migration
  sfDataJson      String? // Lossless SF row snapshot
  recordType      String  @default("WEB") // WEB | DIRECT_MAIL | LIST | BUSINESS | ARCHIVED_WEB | ARCHIVED_DIRECT_MAIL | ARCHIVED_LIST
  businessName    String
  contactName     String
  phone           String
  email           String?
  ein             String? @unique
  industry        String?
  annualRevenue   Float?
  totalDebtEst    Float?
  numberOfLenders Int? // # of lenders/creditors, verified by the opener on the call
  source          String  @default("OTHER") // WEBSITE, REFERRAL, MAILER, PURCHASED_LIST, COLD_CALL, SOCIAL, OTHER
  status          String  @default("NEW") // NEW, CONTACTED, QUALIFIED, UNQUALIFIED, CALLBACK, ENROLLED, CONVERTED, LOST, DNC
  score           Int?
  scoreReason     String?
  notes           String?

  // Marketing Attribution
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  // Click IDs
  eliClickId      String?
  redtrackClickId String?
  gclid           String?
  fbclid          String?
  adClickId       String? // SF: Ad_Click_Id__c (populated by inbound ad-click webhook)

  // Ad attribution (SF parity: Lead_Vendor_Id_Text__c, Ad_Id__c, Campaign_Name__c)
  leadVendorId              String?
  adId                      String?
  campaignName              String?
  hasMultipleMca            Boolean?
  state                     String? // SF state code (NY, FL, etc.) for compliance routing
  lastContactedAt           DateTime?
  nextFollowUpAt            DateTime?
  assignedToId              String?
  assignedTo                User?     @relation(fields: [assignedToId], references: [id])
  // SF parity: track last disposition + assignment date (via triggers)
  lastDisposition           String?
  lastSubDisposition        String?
  lastDispositionAt         DateTime?
  leadAssignmentDate        DateTime?
  // Derived weekly payment from creditor / debt info
  currentTotalWeeklyPayment Float?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  // Conversion (Phase 2)
  convertedAccountId     String?
  convertedAccount       Account?  @relation("LeadConvertedAccount", fields: [convertedAccountId], references: [id])
  convertedContactId     String?
  convertedContact       Contact?  @relation("LeadConvertedContact", fields: [convertedContactId], references: [id])
  convertedOpportunityId String?
  convertedAt            DateTime?

  calls               Call[]
  campaignContacts    CampaignContact[]
  client              Client?
  opportunity         Opportunity?
  tasks               Task[]                   @relation("LeadTasks")
  events              Event[]                  @relation("LeadEvents")
  emails              EmailMessage[]           @relation("LeadEmails")
  sms                 SmsMessage[]             @relation("LeadSms")
  paymentCalculations LeadPaymentCalculation[]
  history             LeadHistory[]
  documents           Document[]               @relation("LeadDocuments")
  debts               LeadDebt[]
  envelopes           Envelope[]               @relation("LeadEnvelopes")
  suppressionEntries  SuppressionEntry[]       @relation("LeadSuppressionEntries")
  cadenceEnrollments  CadenceEnrollment[]      @relation("LeadCadenceEnrollments")
  leadLists           LeadListMember[]         @relation("LeadListsForLead")

  @@index([recordType])
  @@index([convertedAccountId])
}

// Browser-captured call audio transcribed by Deepgram (post-call). Recorded in
// the CRM dialer tab and uploaded on hang-up; not tied to Five9 recordings.
model CallTranscript {
  id            String   @id @default(cuid())
  leadId        String?
  agentUserId   String? // CRM User.id of the agent on the call
  five9Username String?
  phone         String?
  customer      String? // dialed number or contact name from the feed
  direction     String? // INBOUND | OUTBOUND | MANUAL
  durationSec   Int?
  status        String   @default("DONE") // PENDING | DONE | FAILED
  provider      String   @default("deepgram")
  transcript    String? // full plain-text transcript
  summary       String?
  raw           Json? // provider response (utterances/words/confidence)
  error         String?
  createdAt     DateTime @default(now())

  @@index([leadId])
  @@index([agentUserId])
  @@index([createdAt])
}

// ============ CAMPAIGNS ============

model Campaign {
  id          String   @id @default(cuid())
  name        String
  description String?
  dialerMode  String   @default("POWER") // POWER, PREVIEW, MANUAL
  status      String   @default("DRAFT") // DRAFT, ACTIVE, PAUSED, COMPLETED
  script      String?
  startTime   String? // "09:00"
  endTime     String? // "20:00"
  timezone    String   @default("America/New_York")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contacts CampaignContact[]
  agents   CampaignAgent[]
  calls    Call[]
}

model CampaignContact {
  id          String    @id @default(cuid())
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, SKIPPED, MAX_ATTEMPTS
  priority    Int       @default(0)
  attempts    Int       @default(0)
  lastAttempt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([campaignId, leadId])
}

model CampaignAgent {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([campaignId, userId])
}

// ============ CALLS ============

model Call {
  id           String    @id @default(cuid())
  direction    String    @default("OUTBOUND") // INBOUND, OUTBOUND
  status       String    @default("INITIATED") // INITIATED, RINGING, IN_PROGRESS, COMPLETED, NO_ANSWER, BUSY, FAILED, VOICEMAIL
  disposition  String? // INTERESTED, NOT_INTERESTED, CALLBACK, NOT_QUALIFIED, WRONG_NUMBER, VOICEMAIL, NO_ANSWER, DNC, ENROLLED
  leadId       String?
  lead         Lead?     @relation(fields: [leadId], references: [id])
  agentId      String
  agent        User      @relation(fields: [agentId], references: [id])
  campaignId   String?
  campaign     Campaign? @relation(fields: [campaignId], references: [id])
  phoneNumber  String
  duration     Int? // seconds
  recordingUrl String?
  startedAt    DateTime  @default(now())
  answeredAt   DateTime?
  endedAt      DateTime?
  notes        String?
  createdAt    DateTime  @default(now())

  transcript Transcript?
  feedback   CallFeedback?
  task       Task?

  // Five9 webhook fields (port of five9_Call_Log__c)
  five9CallId              String?   @unique
  five9SessionId           String?
  five9AgentFullName       String?
  five9CampaignName        String?
  five9DialerGroup         String?
  five9DispositionName     String?
  five9Skill               String?
  five9DnisAni             String? // dialed-from (inbound) or dialed-to (outbound)
  five9CallType            String? // Manual | Outbound | Inbound | Internal
  five9AttemptCount        Int?
  five9HandleTime          Int? // seconds
  five9HoldTime            Int?
  five9LastDisposition     String?
  five9LastDispositionDate DateTime?
}

// ============ AI: TRANSCRIPTION ============

model Transcript {
  id        String   @id @default(cuid())
  callId    String   @unique
  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  content   String // JSON array of { speaker, text, timestamp }
  summary   String?
  keywords  String? // JSON array of strings
  sentiment String? // positive, negative, neutral
  createdAt DateTime @default(now())
}

// ============ AI: CALL FEEDBACK ============

model CallFeedback {
  id                String   @id @default(cuid())
  callId            String   @unique
  call              Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  agentId           String
  agent             User     @relation(fields: [agentId], references: [id])
  overallScore      Int // 0-100
  talkRatio         Float?
  objectionHandling Int? // 0-100
  closingAttempt    Boolean?
  keyMoments        String? // JSON array
  improvements      String? // JSON array
  strengths         String? // JSON array
  createdAt         DateTime @default(now())
}

// ============ CLIENTS (Post-Enrollment) ============

model Opportunity {
  id                          String                          @id @default(cuid())
  sfId                        String?                         @unique // Salesforce 18-char ID
  // Lossless JSON snapshot of the SF row — every SF field captured here even if
  // we don't have a typed column yet. Use Postgres -> '$.field' for ad-hoc reads.
  sfDataJson                  String?
  recordType                  String                          @default("DEBT_SETTLEMENT") // DEBT_SETTLEMENT | BUYOUT | RESTRUCTURE | LIMITED_ASSET_PROTECTION
  name                        String? // canonical SF Opportunity Name; defaults to "<Account> — <Product>"
  version                     String                          @default("1.0") // SF Version field, bumps on Amend
  leadId                      String?                         @unique
  lead                        Lead?                           @relation(fields: [leadId], references: [id])
  accountId                   String?
  account                     Account?                        @relation(fields: [accountId], references: [id])
  primaryContactId            String?
  primaryContact              Contact?                        @relation("OpportunityPrimaryContact", fields: [primaryContactId], references: [id])
  stage                       String                          @default("Working Opportunity")
  // SF Forecast Category — defaults from stage, can be overridden per Opp
  forecastCategory            String                          @default("PIPELINE") // COMMIT | BEST_CASE | PIPELINE | CLOSED | OMITTED
  // SF parity: track previous stage / sub-disposition (set by OpportunityTrigger)
  lastDisposition             String?
  lastSubDisposition          String?
  lastDispositionAt           DateTime?
  // Bank-change envelope status (ported from SF: Bank_Change_Contract_Status__c)
  bankChangeContractStatus    String? // null | "Pending" | "Completed"
  totalDebt                   Float?
  currentTotalDebt            Float? // SF Current_Total_Debt__c
  estimatedTotalDebt          Float? // SF Estimated_Total_Debt__c
  currentWeeklyPayment        Float? // SF Current_Weekly_Payment__c
  currentMonthlyPayment       Float? // SF Current_Monthly_Payment__c
  weeklyPaymentToDebtRatio    Float? // SF Weekly_Payment_To_Debt_Ratio__c
  expectedCloseDate           DateTime?
  closeDate                   DateTime? // SF CloseDate (separate from expectedCloseDate)
  firstDraftDate              DateTime? // SF First_Draft_Date__c
  firstContractSignedDateOpp  DateTime? // SF First_Contract_Signed_Date__c
  lastContactedAt             DateTime? // SF Last_Contacted_DateTime__c
  lastCallAt                  DateTime? // SF Last_Call__c
  lastEmailAt                 DateTime? // SF Last_Email__c
  lastSmsAt                   DateTime? // SF Last_SMS__c
  probability                 Float? // SF Probability
  // Contact info (denormalized from primary contact / lead)
  oppPhone                    String? // SF Phone__c
  oppEmail                    String? // SF Email__c
  // Sub-disposition + call flow
  subDisposition              String?
  fronter                     String?
  closer                      String?
  callTransferStatus          String?
  transferQualification       String?
  // SF Lead_Id__c — links opp to its source lead
  sfLeadIdText                String?
  // Source / category
  leadSource                  String? // SF LeadSource (picklist)
  leadSourceCategory          String? // SF Lead_Source_Category__c
  // Risk / requirements
  legalPlanRequired           Boolean? // SF Legal_Plan_Required__c
  addendumRequired            Boolean? // SF Addendum_Required__c
  securedParty                String? // SF Secured_Party__c
  highUccRisk                 Boolean? // SF HIGH_UCC_RISK__c
  // Misc
  timezone                    String? // SF Timezone__c
  preferredLanguage           String? // SF Preferred_Language__c
  preferredMethodOfContact    String? // SF Preferred_method_of_Contact__c
  dialerGroup                 String? // SF Dialer_Group__c
  businessStartDate           DateTime? // SF Business_Start_Date__c
  // Client Questionnaire (more)
  processorInfo               String? // SF Processor_Info__c
  lenderAgreementsCollected   String? // SF Lender_Agreements_Collected__c
  statusWithLenders           String? // SF Status_with_Lender_s__c
  firstPaymentToLegal         Boolean? // SF First_Payment_to_Legal__c
  welcomeCallScheduled        DateTime? // SF Welcome_Call_Scheduled__c
  whatWasExplainedToClient    String? // SF What_was_explained_to_client__c
  mainCompetitors             String? // SF MainCompetitors__c
  deliveryInstallationStatus  String? // SF DeliveryInstallationStatus__c
  cojOrTro                    String? // SF COJ_or_TRO__c
  summonsOrJudgment           String? // SF Summons_or_Judgment__c
  orderNumber                 String? // SF OrderNumber__c
  currentGenerators           String? // SF CurrentGenerators__c
  trackingNumber              String? // SF TrackingNumber__c
  lossReason                  String? // SF Loss_Reason__c
  // Standard SF fields
  nextStep                    String? // SF NextStep
  isClosed                    Boolean? // SF IsClosed
  isWon                       Boolean? // SF IsWon
  amount                      Float? // SF Amount
  assignedToId                String?
  assignedTo                  User?                           @relation("OpportunityAssignee", fields: [assignedToId], references: [id])
  // SF Client Questionnaire
  typeOfBusiness              String?
  receivablesCollectionMethod String?
  bankChange                  String?
  highLienRisk                String?
  notes                       String?
  createdAt                   DateTime                        @default(now())
  updatedAt                   DateTime                        @updatedAt
  client                      Client?
  debts                       Debt[]
  documents                   Document[]
  programPlans                ProgramPlan[]
  financialSummaries          FinancialSummary[]
  tasks                       Task[]                          @relation("OpportunityTasks")
  events                      Event[]                         @relation("OpportunityEvents")
  emails                      EmailMessage[]                  @relation("OpportunityEmails")
  history                     OpportunityHistory[]
  paymentCalculations         OpportunityPaymentCalculation[]
  envelopes                   Envelope[]                      @relation("OpportunityEnvelopes")
  cadenceEnrollments          CadenceEnrollment[]             @relation("OpportunityCadenceEnrollments")

  @@index([recordType])
  @@index([accountId])
}

// ============ OPPORTUNITY HISTORY (SF Opportunity Field History parity) ============

model OpportunityHistory {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  field         String
  oldValue      String?
  newValue      String?
  changedById   String?
  changedBy     User?       @relation("OpportunityHistoryChangedBy", fields: [changedById], references: [id])
  changedAt     DateTime    @default(now())

  @@index([opportunityId, changedAt])
}

// ============ OPPORTUNITY PAYMENT CALCULATOR (Lead-side equivalent for opps) ============

model OpportunityPaymentCalculation {
  id                   String      @id @default(cuid())
  opportunityId        String
  opportunity          Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  totalDebt            Float?
  setupFee             Float?
  serviceFee           Float?
  monthlyBankFee       Float?
  citadelFee           Float?
  settlementPercentage Float?
  programFeePercent    Float?
  totalSettlement      Float?
  programFeePeriod     Int?
  frequency            String?
  firstPaymentDate     DateTime?
  estimatedAmount      Float?
  retainerPercentage   Float?
  savedById            String?
  savedBy              User?       @relation("OppPaymentCalcSavedBy", fields: [savedById], references: [id])
  savedAt              DateTime    @default(now())
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([opportunityId, savedAt])
}

model Client {
  id                   String       @id @default(cuid())
  leadId               String       @unique
  lead                 Lead         @relation(fields: [leadId], references: [id])
  opportunityId        String?      @unique
  opportunity          Opportunity? @relation(fields: [opportunityId], references: [id])
  programPlanId        String?      @unique
  programPlan          ProgramPlan? @relation(fields: [programPlanId], references: [id])
  programStartDate     DateTime
  programLength        Int // months
  monthlyPayment       Float
  totalEnrolledDebt    Float
  totalSettled         Float        @default(0)
  totalFees            Float        @default(0)
  status               String       @default("ACTIVE") // ACTIVE, GRADUATED, DROPPED, ON_HOLD
  assignedNegotiatorId String?
  assignedNegotiator   User?        @relation("ClientNegotiator", fields: [assignedNegotiatorId], references: [id])
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  debts     Debt[]
  payments  Payment[]
  documents Document[]
}

model Debt {
  id               String       @id @default(cuid())
  clientId         String?
  client           Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  opportunityId    String?
  opportunity      Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  programPlanId    String?
  programPlan      ProgramPlan? @relation(fields: [programPlanId], references: [id])
  creditorId       String?
  creditor         Creditor?    @relation(fields: [creditorId], references: [id])
  creditorName     String // legacy free-form; preferred is creditorId. Kept for now.
  creditorPhone    String?
  creditorEmail    String?
  accountNumber    String?
  debtType         String? // MCA | CREDIT_LINE | TERM_LOAN | BUSINESS_CC | EQUIPMENT | INVOICE_FACTORING | OTHER (carried from LeadDebt)
  paymentFrequency String? // DAILY | WEEKLY | BI_WEEKLY | MONTHLY | LUMP_SUM
  paymentAmount    Float?
  originalBalance  Float
  currentBalance   Float
  enrolledBalance  Float
  status           String       @default("ENROLLED") // ENROLLED, NEGOTIATING, SETTLED, PAID, DISPUTED, WRITTEN_OFF
  settledAmount    Float?
  settledDate      DateTime?
  savingsAmount    Float?
  savingsPercent   Float?
  lastPaymentDate  DateTime?
  isDelinquent     Boolean      @default(false)
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  negotiations Negotiation[]
  payments     Payment[]
  offers       Offer[]
  settlement   Settlement?
  tasks        Task[]        @relation("DebtTasks")

  @@index([programPlanId])
  @@index([creditorId])
}

model Negotiation {
  id            String   @id @default(cuid())
  debtId        String
  debt          Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  negotiatorId  String
  negotiator    User     @relation(fields: [negotiatorId], references: [id])
  type          String // CALL, EMAIL, LETTER, FAX
  date          DateTime
  offerAmount   Float?
  offerPercent  Float?
  response      String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, COUNTERED
  counterAmount Float?
  notes         String?
  offerId       String?
  offer         Offer?   @relation(fields: [offerId], references: [id])
  createdAt     DateTime @default(now())
}

model Payment {
  id            String    @id @default(cuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  debtId        String?
  debt          Debt?     @relation(fields: [debtId], references: [id])
  type          String // CLIENT_PAYMENT, SETTLEMENT_PAYOUT, FEE
  amount        Float
  scheduledDate DateTime
  paidDate      DateTime?
  status        String    @default("SCHEDULED") // SCHEDULED, COMPLETED, MISSED, CANCELLED
  reference     String?
  notes         String?
  createdAt     DateTime  @default(now())
}

model Document {
  id            String       @id @default(cuid())
  clientId      String?
  client        Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  leadId        String?
  lead          Lead?        @relation("LeadDocuments", fields: [leadId], references: [id], onDelete: Cascade)
  accountId     String?
  account       Account?     @relation("AccountDocuments", fields: [accountId], references: [id], onDelete: Cascade)
  name          String
  type          String // ENGAGEMENT_AGREEMENT, HARDSHIP_LETTER, AUTHORIZATION, SETTLEMENT_OFFER, BANK_STATEMENT, TAX_RETURN, OTHER
  filePath      String
  fileSize      Int?
  uploadedById  String
  uploadedBy    User         @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime     @default(now())

  @@index([leadId])
  @@index([accountId])
}

// ============ PHASE 3: DEBT OPERATIONS ============

model PaymentProcessor {
  id          String   @id @default(cuid())
  name        String   @unique // "RAM Payment Services"
  code        String   @unique // "RAM"
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  programPlans ProgramPlan[]
}

model ProgramPlan {
  id            String            @id @default(cuid())
  recordType    String            @default("DEBT_SETTLEMENT") // DEBT_SETTLEMENT | BUYOUT | RESTRUCTURE | LIMITED_ASSET_PROTECTION
  accountId     String
  account       Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity?      @relation(fields: [opportunityId], references: [id])
  processorId   String?
  processor     PaymentProcessor? @relation(fields: [processorId], references: [id])
  assignedToId  String?
  assignedTo    User?             @relation("ProgramPlanAssignedTo", fields: [assignedToId], references: [id])

  status                 String    @default("ACTIVE") // PROPOSED | ACTIVE | PAUSED | COMPLETED | CANCELLED
  startDate              DateTime
  termMonths             Int
  monthlyAmount          Float // recurring draft amount
  totalProgramCost       Float? // computed: termMonths * monthlyAmount + projected fees
  totalEnrolledDebt      Float?
  // Draft rollups maintained by draftTrigger
  completedPaymentsCount Int       @default(0)
  failedPaymentsCount    Int       @default(0)
  firstDraftDate         DateTime?

  bankAccountLast4  String?
  bankRoutingLast4  String?
  signedDate        DateTime?
  signedDocumentUrl String?
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  debts          Debt[]
  debitSchedules DebitSchedule[]
  drafts         Draft[]
  fees           Fee[]
  client         Client?
  tasks          Task[]          @relation("ProgramPlanTasks")
  cases          Case[]          @relation("ProgramPlanCases")

  @@index([accountId])
  @@index([opportunityId])
  @@index([status])
}

model DebitSchedule {
  id            String      @id @default(cuid())
  programPlanId String
  programPlan   ProgramPlan @relation(fields: [programPlanId], references: [id], onDelete: Cascade)
  frequency     String      @default("MONTHLY") // MONTHLY | BIWEEKLY | WEEKLY
  dayOfMonth    Int? // 1-28 for MONTHLY
  dayOfWeek     Int? // 0-6 for WEEKLY/BIWEEKLY (0=Sunday)
  amount        Float
  startDate     DateTime
  endDate       DateTime?
  nextRunDate   DateTime?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  drafts Draft[]

  @@index([programPlanId])
  @@index([nextRunDate])
}

model Draft {
  id              String         @id @default(cuid())
  programPlanId   String
  programPlan     ProgramPlan    @relation(fields: [programPlanId], references: [id], onDelete: Cascade)
  debitScheduleId String?
  debitSchedule   DebitSchedule? @relation(fields: [debitScheduleId], references: [id])
  scheduledDate   DateTime
  amount          Float
  status          String         @default("SCHEDULED") // SCHEDULED | PROCESSING | SUCCESS | FAILED | RETRYING | CANCELLED
  attemptNumber   Int            @default(1)
  maxAttempts     Int            @default(3)
  parentDraftId   String?
  parentDraft     Draft?         @relation("DraftRetries", fields: [parentDraftId], references: [id])
  retries         Draft[]        @relation("DraftRetries")

  // Processor data
  processorReference String?
  returnCode         String? // ACH return code (R01, R02, etc.) when failed
  returnReason       String?
  processedAt        DateTime?
  settledAt          DateTime?

  cases Case[] @relation("DraftCases")

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programPlanId])
  @@index([debitScheduleId])
  @@index([status])
  @@index([scheduledDate])
}

model Offer {
  id             String    @id @default(cuid())
  debtId         String
  debt           Debt      @relation(fields: [debtId], references: [id], onDelete: Cascade)
  direction      String    @default("FROM_US") // FROM_US | FROM_CREDITOR
  amountOffered  Float
  percentOffered Float // amountOffered / debt.currentBalance
  expiresAt      DateTime?
  status         String    @default("PENDING") // PENDING | COUNTERED | ACCEPTED | REJECTED | EXPIRED | WITHDRAWN
  counterAmount  Float?
  termsNotes     String?
  documentUrl    String?
  createdById    String?
  createdBy      User?     @relation("OfferCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  negotiations Negotiation[]
  settlement   Settlement?

  @@index([debtId])
  @@index([status])
}

model Settlement {
  id             String    @id @default(cuid())
  debtId         String    @unique
  debt           Debt      @relation(fields: [debtId], references: [id], onDelete: Cascade)
  offerId        String?   @unique
  offer          Offer?    @relation(fields: [offerId], references: [id])
  recordType     String    @default("STANDARD") // STANDARD | LITIGATION | BUYOUT | WORKOUT
  settledAmount  Float
  savingsAmount  Float
  savingsPercent Float
  settledDate    DateTime
  payoffDueDate  DateTime?
  payoffPaidDate DateTime?
  status         String    @default("PENDING_PAYOFF") // PENDING_PAYOFF | PAID | CANCELLED
  approvedById   String?
  approvedBy     User?     @relation("SettlementApprovedBy", fields: [approvedById], references: [id])
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
}

model Fee {
  id            String      @id @default(cuid())
  programPlanId String
  programPlan   ProgramPlan @relation(fields: [programPlanId], references: [id], onDelete: Cascade)
  recordType    String      @default("MONTHLY_ADMIN") // SETUP | MONTHLY_ADMIN | SETTLEMENT_SUCCESS | CANCELLATION | OTHER
  amount        Float
  chargedDate   DateTime
  status        String      @default("PENDING") // PENDING | CHARGED | WAIVED | REFUNDED
  chargedById   String?
  chargedBy     User?       @relation("FeeChargedBy", fields: [chargedById], references: [id])
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([programPlanId])
  @@index([recordType])
}

model PaymentSummary {
  id                String    @id @default(cuid())
  accountId         String    @unique
  account           Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  totalCollected    Float     @default(0)
  totalDisbursed    Float     @default(0)
  totalFees         Float     @default(0)
  totalSettled      Float     @default(0)
  totalSavings      Float     @default(0)
  draftSuccessCount Int       @default(0)
  draftFailedCount  Int       @default(0)
  lastDraftDate     DateTime?
  recomputedAt      DateTime  @default(now())
}

model FinancialSummary {
  id               String       @id @default(cuid())
  accountId        String
  account          Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  opportunityId    String?
  opportunity      Opportunity? @relation(fields: [opportunityId], references: [id])
  monthlyIncome    Float
  monthlyExpenses  Float
  disposableIncome Float // computed: income - expenses
  totalAssets      Float?
  totalLiabilities Float?
  notes            String?
  capturedAt       DateTime     @default(now())
  capturedById     String?

  @@index([accountId, capturedAt])
}

// ============ PHASE 4: ACTIVITIES (Task + Event) ============

model Task {
  id         String @id @default(cuid())
  recordType String @default("ACTIVITY") // ACTIVITY | DISPOSITION
  subject    String
  type       String @default("TASK") // CALL | EMAIL | LETTER | TASK | NOTE | OTHER
  status     String @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | COMPLETED | DEFERRED | WAITING
  priority   String @default("NORMAL") // LOW | NORMAL | HIGH

  // Polymorphic "what"
  accountId     String?
  account       Account?     @relation("AccountTasks", fields: [accountId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation("OpportunityTasks", fields: [opportunityId], references: [id])
  debtId        String?
  debt          Debt?        @relation("DebtTasks", fields: [debtId], references: [id])
  programPlanId String?
  programPlan   ProgramPlan? @relation("ProgramPlanTasks", fields: [programPlanId], references: [id])

  // Polymorphic "who"
  leadId    String?
  lead      Lead?    @relation("LeadTasks", fields: [leadId], references: [id])
  contactId String?
  contact   Contact? @relation("ContactTasks", fields: [contactId], references: [id])

  // Ownership / scheduling
  ownerId     String?
  owner       User?     @relation("TaskOwner", fields: [ownerId], references: [id])
  dueDate     DateTime?
  reminderAt  DateTime?
  completedAt DateTime?

  // Disposition-specific
  disposition  String?
  callbackDate DateTime?
  outcome      String?
  callId       String?   @unique
  call         Call?     @relation(fields: [callId], references: [id])
  caseId       String?
  case         Case?     @relation("CaseTasks", fields: [caseId], references: [id])

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, status])
  @@index([dueDate])
  @@index([accountId])
  @@index([opportunityId])
  @@index([leadId])
  @@index([contactId])
  @@index([caseId])
}

model Event {
  id          String   @id @default(cuid())
  recordType  String   @default("EVENT") // EVENT | EVENT_DISPOSITION
  subject     String
  description String?
  location    String?
  status      String   @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED | NO_SHOW
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean  @default(false)

  // Polymorphic relations
  accountId     String?
  account       Account?     @relation("AccountEvents", fields: [accountId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation("OpportunityEvents", fields: [opportunityId], references: [id])
  leadId        String?
  lead          Lead?        @relation("LeadEvents", fields: [leadId], references: [id])
  contactId     String?
  contact       Contact?     @relation("ContactEvents", fields: [contactId], references: [id])

  ownerId String?
  owner   User?   @relation("EventOwner", fields: [ownerId], references: [id])

  caseId String?
  case   Case?   @relation("CaseEvents", fields: [caseId], references: [id])

  disposition String?
  outcome     String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, status])
  @@index([startAt])
  @@index([accountId])
  @@index([opportunityId])
  @@index([leadId])
  @@index([contactId])
  @@index([caseId])
}

// ============ PHASE 5: CASE MANAGEMENT ============

model Case {
  id              String  @id @default(cuid())
  caseNumber      String  @unique
  recordType      String  @default("SUPPORT") // SUPPORT | PAYMENT_ISSUE | SKIP_PAYMENT | CANCELLATION | BANK_UPDATE | DOCUMENT_REQUEST
  subject         String
  description     String?
  status          String  @default("NEW") // NEW | OPEN | IN_PROGRESS | WAITING_ON_CUSTOMER | ESCALATED | RESOLVED | CLOSED
  priority        String  @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  origin          String  @default("PHONE") // PHONE | EMAIL | WEB | CHAT | OTHER
  escalationLevel String  @default("L1") // L1 | L2 | L3

  // Polymorphic "what"
  accountId     String?
  account       Account?     @relation("AccountCases", fields: [accountId], references: [id])
  contactId     String?
  contact       Contact?     @relation("ContactCases", fields: [contactId], references: [id])
  programPlanId String?
  programPlan   ProgramPlan? @relation("ProgramPlanCases", fields: [programPlanId], references: [id])
  draftId       String?
  draft         Draft?       @relation("DraftCases", fields: [draftId], references: [id])

  // Ownership: user OR queue (Group)
  ownerId      String?
  owner        User?   @relation("CaseOwner", fields: [ownerId], references: [id])
  ownerGroupId String?
  ownerGroup   Group?  @relation("CaseOwnerGroup", fields: [ownerGroupId], references: [id])

  parentCaseId String?
  parentCase   Case?   @relation("CaseHierarchy", fields: [parentCaseId], references: [id])
  childCases   Case[]  @relation("CaseHierarchy")

  // Approval (lightweight; full ApprovalProcess in Phase 7)
  requiresApproval Boolean   @default(false)
  approvedById     String?
  approvedBy       User?     @relation("CaseApprover", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  approvalNotes    String?

  // SLA / lifecycle timestamps
  slaDueAt        DateTime?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?

  createdById String?
  createdBy   User?   @relation("CaseCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments CaseComment[]
  tasks    Task[]         @relation("CaseTasks")
  events   Event[]        @relation("CaseEvents")
  emails   EmailMessage[] @relation("CaseEmails")
  sms      SmsMessage[]   @relation("CaseSms")

  @@index([status])
  @@index([ownerId])
  @@index([ownerGroupId])
  @@index([accountId])
  @@index([recordType])
}

model CaseComment {
  id         String   @id @default(cuid())
  caseId     String
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation("CaseCommentAuthor", fields: [authorId], references: [id])
  body       String
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([caseId, createdAt])
}

// ============ PHASE 6: COMMUNICATIONS + INTEGRATIONS ============

model EmailMessage {
  id          String  @id @default(cuid())
  direction   String  @default("OUTBOUND") // INBOUND | OUTBOUND
  status      String  @default("DRAFT") // DRAFT | QUEUED | SENT | DELIVERED | OPENED | CLICKED | BOUNCED | COMPLAINED | FAILED
  fromAddress String
  toAddresses String // CSV
  cc          String?
  bcc         String?
  subject     String
  bodyText    String?
  bodyHtml    String?

  templateId String?
  template   EmailTemplate? @relation(fields: [templateId], references: [id])

  accountId     String?
  account       Account?     @relation("AccountEmails", fields: [accountId], references: [id])
  contactId     String?
  contact       Contact?     @relation("ContactEmails", fields: [contactId], references: [id])
  leadId        String?
  lead          Lead?        @relation("LeadEmails", fields: [leadId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation("OpportunityEmails", fields: [opportunityId], references: [id])
  caseId        String?
  case          Case?        @relation("CaseEmails", fields: [caseId], references: [id])

  ownerId String?
  owner   User?   @relation("EmailOwner", fields: [ownerId], references: [id])

  providerMessageId String?
  provider          String?
  errorReason       String?

  sentAt      DateTime?
  deliveredAt DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?
  bouncedAt   DateTime?

  // Mass email tracking. trackingId is a short random token embedded in
  // the open-pixel URL + click-rewrite URLs. openCount/clickCount increment
  // every time the pixel/click endpoint is hit. firstClickedAt is the first
  // click timestamp (clickedAt is kept as the "last clicked" for back compat).
  massEmailId    String?
  massEmail      MassEmail? @relation("MassEmailMessages", fields: [massEmailId], references: [id])
  trackingId     String?    @unique
  firstClickedAt DateTime?
  openCount      Int        @default(0)
  clickCount     Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([direction])
  @@index([accountId])
  @@index([leadId])
  @@index([caseId])
  @@index([massEmailId])
  @@index([trackingId])
}

model MassEmail {
  id             String         @id @default(cuid())
  name           String
  templateId     String?
  template       EmailTemplate? @relation("MassEmailTemplate", fields: [templateId], references: [id])
  fromUserId     String?
  fromUser       User?          @relation("MassEmailFromUser", fields: [fromUserId], references: [id])
  audienceType   String // "filter" | "list"
  audienceFilter Json           @default("{}") // { entityType, filters }
  audienceIds    String[]       @default([]) // if list type, the specific entity IDs
  totalCount     Int            @default(0)
  sentCount      Int            @default(0)
  failedCount    Int            @default(0)
  openCount      Int            @default(0)
  clickCount     Int            @default(0)
  status         String         @default("DRAFT") // DRAFT | SENDING | SENT | FAILED
  scheduledAt    DateTime?
  sentAt         DateTime?
  createdById    String?
  createdBy      User?          @relation("MassEmailCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  messages       EmailMessage[] @relation("MassEmailMessages")

  @@index([status])
  @@index([createdById])
}

model SmsMessage {
  id         String @id @default(cuid())
  direction  String @default("OUTBOUND") // INBOUND | OUTBOUND
  status     String @default("QUEUED") // QUEUED | SENT | DELIVERED | FAILED | RECEIVED
  fromNumber String
  toNumber   String
  body       String
  segments   Int    @default(1)

  accountId String?
  account   Account? @relation("AccountSms", fields: [accountId], references: [id])
  contactId String?
  contact   Contact? @relation("ContactSms", fields: [contactId], references: [id])
  leadId    String?
  lead      Lead?    @relation("LeadSms", fields: [leadId], references: [id])
  caseId    String?
  case      Case?    @relation("CaseSms", fields: [caseId], references: [id])

  ownerId String?
  owner   User?   @relation("SmsOwner", fields: [ownerId], references: [id])

  providerMessageId String?
  provider          String?
  errorReason       String?
  errorCode         String?

  sentAt      DateTime?
  deliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([accountId])
  @@index([leadId])
}

model EmailTemplate {
  id            String  @id @default(cuid())
  name          String  @unique
  developerName String  @unique
  subject       String
  bodyText      String?
  bodyHtml      String?
  description   String?
  folder        String? @default("General")
  isActive      Boolean @default(true)
  createdById   String?
  createdBy     User?   @relation("EmailTemplateAuthor", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emails       EmailMessage[]
  cadenceSteps CadenceStep[]             @relation("CadenceStepEmailTemplate")
  massEmails   MassEmail[]               @relation("MassEmailTemplate")
  attachments  EmailTemplateAttachment[]
}

model EmailTemplateAttachment {
  id           String        @id @default(cuid())
  templateId   String
  template     EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  filename     String
  contentType  String
  byteSize     Int
  storagePath  String // relative path under /data/email-attachments
  uploadedById String?
  uploadedBy   User?         @relation("EmailAttachmentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime      @default(now())

  @@index([templateId])
}

model IntegrationCredential {
  id          String    @id @default(cuid())
  provider    String // FIVE9 | TWILIO | TELNYX | DOCUSIGN | PARDOT | KLAVIYO | SENDGRID
  name        String
  isActive    Boolean   @default(true)
  config      Json
  scopes      String?
  rotatedAt   DateTime?
  createdById String?
  createdBy   User?     @relation("IntegrationCredentialAuthor", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, name])
  @@index([provider, isActive])
}

model WebhookEvent {
  id             String    @id @default(cuid())
  source         String // PAYMENT_PROCESSOR | LEAD_IMPORT | OPT_OUT | AD_CLICK | TWILIO | SENDGRID
  endpoint       String
  ipAddress      String?
  headers        Json?
  payload        Json?
  signature      String?
  signatureValid Boolean?
  status         String    @default("RECEIVED") // RECEIVED | PROCESSED | FAILED | IGNORED
  resultNote     String?
  processedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([source, status])
  @@index([createdAt])
}

// ============ DISPOSITIONS (SF picklist parity — per-entity picklist values) ============

model Disposition {
  id                String   @id @default(cuid())
  entity            String // "Lead" | "Task" | "Call" | "Negotiation"
  category          String // "SUB_DISPOSITION" | "CALL_OUTCOME"
  value             String // canonical stored value
  label             String // UI label
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  // When set, picking this disposition updates Lead.status to this value
  leadStatusMapping String?
  // Stage gate — when set, this sub-disposition is only selectable when Stage = this value
  stage             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([entity, category, value, stage])
  @@index([entity, category, isActive])
  @@index([entity, stage])
}

// ============ LEAD PAYMENT CALCULATOR (SF parity) ============

model LeadPaymentCalculation {
  id                   String    @id @default(cuid())
  leadId               String
  lead                 Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  totalDebt            Float?
  setupFee             Float?
  serviceFee           Float?
  monthlyBankFee       Float?
  citadelFee           Float?
  settlementPercentage Float? // e.g. 50.0 = 50%
  programFeePercent    Float?
  totalSettlement      Float?
  programFeePeriod     Int? // periods (weeks/months)
  frequency            String? // DAILY | WEEKLY | BI_WEEKLY | MONTHLY
  firstPaymentDate     DateTime?
  estimatedAmount      Float?
  retainerPercentage   Float?
  savedById            String?
  savedBy              User?     @relation("PaymentCalcSavedBy", fields: [savedById], references: [id])
  savedAt              DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([leadId, savedAt])
}

// ============ LEAD DEBT (Debt Information tab on Lead detail) ============

model LeadDebt {
  id            String   @id @default(cuid())
  leadId        String
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type          String // MCA | CREDIT_LINE | TERM_LOAN | BUSINESS_CC | EQUIPMENT | INVOICE_FACTORING | OTHER
  creditorName  String?
  amount        Float
  frequency     String // DAILY | WEEKLY | BI_WEEKLY | MONTHLY | LUMP_SUM
  paymentAmount Float?
  status        String   @default("ACTIVE") // ACTIVE | DEFAULTED | SETTLED | PAID_OFF | DISPUTED
  notes         String?
  createdById   String?
  createdBy     User?    @relation("LeadDebtCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([leadId])
}

// ============ LEAD HISTORY (SF Lead History parity — every field change) ============

model LeadHistory {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  field       String // canonical field name on Lead
  oldValue    String?
  newValue    String?
  changedById String?
  changedBy   User?    @relation("LeadHistoryChangedBy", fields: [changedById], references: [id])
  changedAt   DateTime @default(now())

  @@index([leadId, changedAt])
}

// ============ LIST VIEWS (SF List View parity) ============

model ListView {
  id            String   @id @default(cuid())
  entity        String // "Lead" | "Account" | "Contact" | "Opportunity" | "Case" | ...
  name          String // "Web Leads"
  developerName String? // "Web_Leads" — optional for user views
  filters       Json     @default("[]") // [{ field, op, value }]
  columns       Json? // [string] — column keys to show
  sortField     String?
  sortDir       String   @default("desc") // asc | desc
  ownerId       String?
  owner         User?    @relation("ListViewOwner", fields: [ownerId], references: [id])
  isShared      Boolean  @default(false) // visible to all users
  isPinned      Boolean  @default(false) // pin on the view picker
  isSystem      Boolean  @default(false) // pre-seeded, can't be deleted by users
  sortOrder     Int      @default(0) // for ordering in the picker
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([entity, developerName])
  @@index([entity, ownerId])
  @@index([entity, isShared])
}

// ============ MARKETING (inbound lead capture + outbound postbacks) ============

model MarketingSource {
  id             String                @id @default(cuid())
  name           String
  slug           String                @unique
  apiKey         String                @unique
  isActive       Boolean               @default(true)
  fieldMapping   Json                  @default("{}")
  defaultOwnerId String?
  defaultOwner   User?                 @relation("MktSourceOwner", fields: [defaultOwnerId], references: [id])
  defaultQueueId String?
  defaultQueue   Group?                @relation("MktSourceQueue", fields: [defaultQueueId], references: [id])
  leadSource     String?
  requiredFields String[]              @default([])
  dedupeBy       String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  inboundLogs    MarketingInboundLog[]
}

model MarketingInboundLog {
  id           String          @id @default(cuid())
  sourceId     String
  source       MarketingSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  rawPayload   Json
  parsed       Json?
  leadId       String?
  status       String
  errorMessage String?
  ip           String?
  userAgent    String?
  receivedAt   DateTime        @default(now())

  @@index([sourceId, receivedAt])
}

model MarketingPostbackEndpoint {
  id              String                 @id @default(cuid())
  name            String
  url             String
  method          String                 @default("POST")
  authHeaderKey   String?
  authHeaderValue String?
  payloadTemplate String?
  events          String[]               @default([])
  isActive        Boolean                @default(true)
  retryOnFail     Boolean                @default(true)
  maxAttempts     Int                    @default(3)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  logs            MarketingPostbackLog[]
}

// ============ FORECASTING (Quotas) ============

model Quota {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("QuotaUser", fields: [userId], references: [id], onDelete: Cascade)
  period    String // YYYY-MM (monthly) or YYYY-Qn (quarterly)
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, period])
  @@index([userId])
  @@index([period])
}

model MarketingPostbackLog {
  id             String                    @id @default(cuid())
  endpointId     String
  endpoint       MarketingPostbackEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event          String
  entityType     String?
  entityId       String?
  requestBody    Json
  responseBody   Json?
  responseStatus Int?
  status         String
  attempts       Int                       @default(0)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime                  @default(now())

  @@index([endpointId, createdAt])
}

// ============ DASHBOARDS (managers compose KPI + chart tiles) ============

model Dashboard {
  id          String          @id @default(cuid())
  name        String
  description String?
  layout      Json            @default("[]") // array of {tileId, x, y, w, h} — 12-col grid
  isShared    Boolean         @default(true)
  createdById String?
  createdBy   User?           @relation("DashboardCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tiles       DashboardTile[]

  @@index([createdById])
}

model DashboardTile {
  id          String    @id @default(cuid())
  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  kind        String // "kpi" | "count" | "sum" | "bar" | "table" | "report"
  title       String
  // For built-in kinds: the queryKey selects a hardcoded query
  queryKey    String?
  // For report-backed kinds: reference a saved Report
  reportId    String?
  // Free-form display config: { color, format, valueLabel, etc. }
  config      Json      @default("{}")
  position    Json      @default("{\"x\":0,\"y\":0,\"w\":3,\"h\":2}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([dashboardId])
}

// ============ REPORTS (SF-style saved report definitions) ============

model Report {
  id          String    @id @default(cuid())
  name        String
  description String?
  objectType  String // "Lead" | "Opportunity" | "Account" | "Case" | "Task" | "Event" | "Envelope"
  // JSON arrays
  columns     Json      @default("[]") // string[] of field keys like "owner.name"
  filters     Json      @default("[]") // [{ field, operator, value }]
  groupBy     String?
  sortBy      String?
  sortDir     String    @default("asc") // asc | desc
  summarize   Json      @default("[]") // [{ field, kind: "count" | "sum" | "avg" }]
  rowLimit    Int       @default(2000)
  isShared    Boolean   @default(true)
  createdById String?
  createdBy   User?     @relation("ReportCreatedBy", fields: [createdById], references: [id])
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([objectType])
  @@index([createdById])
}

// ============ APPROVAL PROCESSES (SF Approval Process parity) ============

model ApprovalProcess {
  id                   String            @id @default(cuid())
  name                 String
  description          String?
  entityType           String // "Opportunity" | "Settlement" | "Fee" | "Offer" | "Lead" | "Case"
  isActive             Boolean           @default(true)
  // JSON entry criteria: [{ field, operator, value }]
  entryCriteria        Json              @default("[]")
  // What happens on final approval: [{ kind: "setField", field, value }] etc.
  finalApprovalActions Json              @default("[]")
  // What happens on rejection
  rejectionActions     Json              @default("[]")
  // user IDs or role names that can submit; empty = anyone
  initialSubmitters    Json              @default("[]")
  createdById          String?
  createdBy            User?             @relation("ApprovalProcessCreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  steps                ApprovalStep[]
  requests             ApprovalRequest[]

  @@index([entityType, isActive])
}

model ApprovalStep {
  id                  String            @id @default(cuid())
  processId           String
  process             ApprovalProcess   @relation(fields: [processId], references: [id], onDelete: Cascade)
  order               Int
  name                String
  // JSON criteria specific to this step (e.g. only fire if amount > X)
  criteria            Json              @default("[]")
  // Approver IDs (User.id). The first one to approve advances.
  approverUserIds     String[]          @default([])
  // For "manager of submitter" pattern: if true, use submitter's manager instead of a fixed list.
  useSubmitterManager Boolean           @default(false)
  // Allow any approver to skip ahead.
  allowSkip           Boolean           @default(false)
  createdAt           DateTime          @default(now())
  requests            ApprovalRequest[] @relation("ApprovalRequestCurrentStep")
  actions             ApprovalAction[]

  @@index([processId, order])
}

model ApprovalRequest {
  id            String           @id @default(cuid())
  processId     String
  process       ApprovalProcess  @relation(fields: [processId], references: [id])
  entityType    String
  entityId      String
  submittedById String?
  submittedBy   User?            @relation("ApprovalRequestSubmittedBy", fields: [submittedById], references: [id])
  status        String           @default("PENDING") // PENDING | APPROVED | REJECTED | RECALLED
  currentStepId String?
  currentStep   ApprovalStep?    @relation("ApprovalRequestCurrentStep", fields: [currentStepId], references: [id])
  comments      String?
  submittedAt   DateTime         @default(now())
  decidedAt     DateTime?
  // Snapshot of the record at submission (audit)
  snapshot      Json?
  actions       ApprovalAction[]

  @@index([entityType, entityId])
  @@index([status])
  @@index([submittedById])
}

model ApprovalAction {
  id        String          @id @default(cuid())
  requestId String
  request   ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stepId    String?
  step      ApprovalStep?   @relation(fields: [stepId], references: [id])
  actorId   String?
  actor     User?           @relation("ApprovalActionActor", fields: [actorId], references: [id])
  kind      String // SUBMITTED | APPROVED | REJECTED | RECALLED | REASSIGNED | COMMENT
  comments  String?
  createdAt DateTime        @default(now())

  @@index([requestId, createdAt])
}

// ============ IN-APP NOTIFICATIONS (SF-style) ============

model Notification {
  id          String    @id @default(cuid())
  recipientId String
  recipient   User      @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  // What kind of event. OWNER_ASSIGNED | MENTION | APPROVAL_REQUEST |
  // APPROVAL_DECIDED | ENVELOPE_SIGNED | MASS_EMAIL_DONE | TASK_DUE |
  // LEAD_INBOUND | GENERIC
  kind        String
  // Short headline rendered in the dropdown
  title       String
  // Body / preview text
  body        String?
  // Where to navigate when clicked (relative path)
  url         String?
  // Related entity (for filtering / icon)
  entityType  String?
  entityId    String?
  // Optional actor (the user who caused this notification)
  actorId     String?
  actor       User?     @relation("NotificationActor", fields: [actorId], references: [id])
  // Lifecycle
  readAt      DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
  @@index([entityType, entityId])
}

// ============ CHATTER (SF-style team feeds + groups + @mentions + follows) ============

model ChatterGroup {
  id          String          @id @default(cuid())
  name        String
  description String?
  /// "public" | "private"
  visibility  String          @default("public")
  avatarUrl   String?
  ownerId     String?
  owner       User?           @relation("ChatterGroupOwner", fields: [ownerId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  members     ChatterMember[]
  posts       ChatterPost[]

  @@index([visibility])
}

model ChatterMember {
  id       String       @id @default(cuid())
  groupId  String
  group    ChatterGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User         @relation("ChatterMember", fields: [userId], references: [id], onDelete: Cascade)
  role     String       @default("member") // member | manager | owner
  joinedAt DateTime     @default(now())

  @@unique([groupId, userId])
}

model ChatterPost {
  id         String            @id @default(cuid())
  // Either a group post...
  groupId    String?
  group      ChatterGroup?     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // ...or a per-record post (entityType + entityId)
  entityType String?
  entityId   String?
  authorId   String
  author     User              @relation("ChatterPostAuthor", fields: [authorId], references: [id])
  body       String
  mentions   String[]          @default([]) // user IDs extracted at post time
  parentId   String?
  parent     ChatterPost?      @relation("ChatterPostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    ChatterPost[]     @relation("ChatterPostReplies")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  reactions  ChatterReaction[]

  @@index([groupId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([authorId])
  @@index([parentId])
}

model ChatterReaction {
  id        String      @id @default(cuid())
  postId    String
  post      ChatterPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation("ChatterReactionUser", fields: [userId], references: [id])
  emoji     String // "like" | "love" | "laugh", store as text, not Unicode
  createdAt DateTime    @default(now())

  @@unique([postId, userId])
}

model ChatterFollow {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("ChatterFollow", fields: [userId], references: [id], onDelete: Cascade)
  // Either follow a group OR a record
  groupId    String?
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())

  @@unique([userId, groupId, entityType, entityId])
  @@index([groupId])
  @@index([entityType, entityId])
}

// ============ CONTENT LIBRARY (central Files) ============
// SF-style Files. Documents live in optional folders, have versions, can be
// linked to many records (Lead/Opp/Account/etc.), and can be shared publicly
// via tokenized links with optional expiry / password / revocation.

model ContentLibraryFolder {
  id        String                 @id @default(cuid())
  name      String
  parentId  String?
  parent    ContentLibraryFolder?  @relation("FolderParent", fields: [parentId], references: [id])
  children  ContentLibraryFolder[] @relation("FolderParent")
  ownerId   String?
  owner     User?                  @relation("ContentFolderOwner", fields: [ownerId], references: [id])
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  files     ContentDocument[]

  @@index([parentId])
}

model ContentDocument {
  id              String                @id @default(cuid())
  title           String
  description     String?
  folderId        String?
  folder          ContentLibraryFolder? @relation(fields: [folderId], references: [id])
  ownerId         String?
  owner           User?                 @relation("ContentDocOwner", fields: [ownerId], references: [id])
  latestVersionId String?               @unique
  latestVersion   ContentVersion?       @relation("ContentLatestVersion", fields: [latestVersionId], references: [id], onDelete: SetNull)
  versions        ContentVersion[]      @relation("ContentDocumentVersions")
  shares          ContentShareLink[]
  records         ContentRecordLink[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([folderId])
  @@index([ownerId])
}

model ContentVersion {
  id            String           @id @default(cuid())
  documentId    String
  document      ContentDocument  @relation("ContentDocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int
  filename      String
  contentType   String
  byteSize      Int
  storagePath   String
  uploadedById  String?
  uploadedBy    User?            @relation("ContentVersionUploader", fields: [uploadedById], references: [id])
  createdAt     DateTime         @default(now())
  latestDocLink ContentDocument? @relation("ContentLatestVersion")

  @@unique([documentId, versionNumber])
}

model ContentRecordLink {
  id         String          @id @default(cuid())
  documentId String
  document   ContentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  linkedById String?
  linkedBy   User?           @relation("ContentRecordLinkedBy", fields: [linkedById], references: [id])
  createdAt  DateTime        @default(now())

  @@unique([documentId, entityType, entityId])
  @@index([entityType, entityId])
}

model ContentShareLink {
  id            String          @id @default(cuid())
  documentId    String
  document      ContentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  token         String          @unique @default(cuid())
  createdById   String?
  createdBy     User?           @relation("ContentShareCreatedBy", fields: [createdById], references: [id])
  expiresAt     DateTime?
  passwordHash  String?
  downloadCount Int             @default(0)
  isRevoked     Boolean         @default(false)
  createdAt     DateTime        @default(now())

  @@index([documentId])
  @@index([token])
}

// ============ PATH GUIDANCE ============
// SF-style Path Guidance for Success + Key Fields panel. Each row binds an
// entity+stage pair to a key-field checklist and a markdown guidance block
// that appears next to the Path tracker on the record detail page.
model PathGuidance {
  id          String   @id @default(cuid())
  entityType  String // "Lead" | "Opportunity" | "Account" | "Case"
  stage       String // The exact stage label (matches sf-canonical values)
  // Array of field paths surfaced as key fields. Paths reference the entity:
  // ["leadName", "businessName", "amount", "owner.name"]
  keyFields   Json     @default("[]")
  // Markdown guidance text shown to the rep at this stage
  guidance    String?
  // Order in the editor list (e.g. sort by stage progression)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation("PathGuidanceCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([entityType, stage])
  @@index([entityType, stage])
}

// ============ VALIDATION RULES ============
// SF-style declarative validation. Admins author rules per entity. Runtime
// evaluator runs them in the trigger middleware before insert/update. A rule
// whose condition evaluates TRUE means "validation failed" (SF convention),
// and the configured errorMessage is thrown.
model ValidationRule {
  id             String   @id @default(cuid())
  name           String
  description    String?
  entityType     String // "Lead" | "Opportunity" | "Account" | "Case" | "Task" | "Event"
  errorMessage   String
  // JSON AST representing the condition. Shape:
  // { kind: "and"|"or", conditions: [{ field, operator, value }] }
  // operators: equals, notEquals, contains, startsWith, endsWith, gt, gte,
  //   lt, lte, isNull, isNotNull, in, notIn
  condition      Json     @default("{\"kind\":\"and\",\"conditions\":[]}")
  // Apply on insert, update, or both
  fireOn         String   @default("both") // insert | update | both
  // Optional error display field (UI hint for which field the error attaches to)
  errorFieldName String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdById    String?
  createdBy      User?    @relation("ValidationRuleCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([entityType, isActive])
}

// ============ FLOWS ============
// SF-style declarative automation. Admins compose flows visually (triggers +
// decision + action + wait nodes). The runtime executor walks the graph when
// matching trigger events fire and persists run state for waits/resumes.
model Flow {
  id                    String    @id @default(cuid())
  name                  String
  description           String?
  entityType            String // "Lead" | "Opportunity" | "Account" | "Case" | "Task" | "Event"
  triggerEvent          String // INSERT | UPDATE | INSERT_OR_UPDATE
  // Run only when these field values change (for UPDATE flows). Empty = any change.
  triggerOnFieldChanges Json      @default("[]")
  // Entry criteria, same condition AST shape as ValidationRule
  entryCriteria         Json      @default("{\"kind\":\"and\",\"conditions\":[]}")
  isActive              Boolean   @default(true)
  // JSON graph: { nodes, edges }
  graph                 Json      @default("{\"nodes\":[],\"edges\":[]}")
  createdById           String?
  createdBy             User?     @relation("FlowCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  runs                  FlowRun[]

  @@index([entityType, isActive])
}

model FlowRun {
  id                String    @id @default(cuid())
  flowId            String
  flow              Flow      @relation(fields: [flowId], references: [id], onDelete: Cascade)
  entityType        String
  entityId          String
  status            String    @default("RUNNING") // RUNNING | COMPLETED | FAILED | WAITING | CANCELLED
  currentNodeId     String?
  // JSON trace: array of { nodeId, kind, at, status, output?, error? }
  trace             Json      @default("[]")
  scheduledResumeAt DateTime?
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  errorMessage      String?

  @@index([flowId, startedAt])
  @@index([status])
  @@index([status, scheduledResumeAt])
}

// ============ OBJECT MANAGER (SF-style schema browser, per-object field metadata) ============
// Field metadata itself is read-only from Prisma DMMF at runtime. These two
// tables only hold user-editable overrides: display labels/help text per
// field, and saved Page Layouts for record detail pages.

model ObjectFieldLabel {
  id          String   @id @default(cuid())
  entityType  String
  fieldName   String
  label       String // display label override
  helpText    String?
  isRequired  Boolean  @default(false)
  isReadOnly  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdById String?
  createdBy   User?    @relation("ObjectFieldLabelCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([entityType, fieldName])
  @@index([entityType])
}

model PageLayout {
  id          String   @id @default(cuid())
  entityType  String
  name        String // e.g. "Default Lead Layout"
  recordType  String? // optional filter, matches recordType on record
  isDefault   Boolean  @default(false)
  // JSON layout: { sections: [{ name, columns: 1|2, fields: [{ fieldName, span }] }] }
  layout      Json     @default("{\"sections\":[]}")
  createdById String?
  createdBy   User?    @relation("PageLayoutCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([entityType, isDefault])
}

// ============ ENGAGEMENT SEQUENCES (Pardot-style drip with branching) ============
// A focused layer on top of EmailMessage + Flow. Sequences auto-enroll leads
// matching entryCriteria and walk them through ordered steps (send_email,
// wait, branch_on_open, etc). The cron at /api/engagement/process drives
// evaluateAndEnroll() + processEnrollments() every few minutes.
model EngagementSequence {
  id                String   @id @default(cuid())
  name              String
  description       String?
  // Entity type the sequence runs on. v1 only wires "Lead".
  entityType        String   @default("Lead")
  isActive          Boolean  @default(true)
  // Same AST shape as ValidationRule.condition and Flow.entryCriteria.
  entryCriteria     Json     @default("{\"kind\":\"and\",\"conditions\":[]}")
  // When false, a lead that has previously been enrolled (any status) is
  // skipped during auto-enroll. Manual enroll always bypasses this.
  allowReEnroll     Boolean  @default(false)
  // Cap how many enrollments to create per evaluateAndEnroll tick.
  maxEnrollsPerTick Int      @default(500)
  // Aggregate counters refreshed on each enroll / completion.
  totalEnrolled     Int      @default(0)
  totalCompleted    Int      @default(0)
  totalExited       Int      @default(0)
  createdById       String?
  createdBy         User?    @relation("EngagementSequenceCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  steps       EngagementStep[]
  enrollments EngagementEnrollment[]

  @@index([entityType, isActive])
}

model EngagementStep {
  id         String             @id @default(cuid())
  sequenceId String
  sequence   EngagementSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  order      Int
  // send_email | wait | branch_on_open | branch_on_click |
  // update_score | add_to_list | remove_from_list | task | exit
  kind       String
  label      String
  // Per-kind config JSON. See src/lib/engagement/steps.ts for the schema.
  config     Json               @default("{}")
  createdAt  DateTime           @default(now())

  @@index([sequenceId, order])
}

model EngagementEnrollment {
  id                 String             @id @default(cuid())
  sequenceId         String
  sequence           EngagementSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  entityType         String
  entityId           String
  status             String             @default("ACTIVE") // ACTIVE | COMPLETED | EXITED | PAUSED
  currentStepOrder   Int                @default(0)
  // ACTIVE rows whose nextActionAt is in the past get processed by the cron.
  nextActionAt       DateTime?
  // Append-only audit of every step fired. Array of
  // { at, stepOrder, kind, label, result, error? }
  history            Json               @default("[]")
  enteredAt          DateTime           @default(now())
  finishedAt         DateTime?
  // Last EmailMessage id sent — branch_on_open / branch_on_click check this
  // message's openedAt / firstClickedAt to pick which path to follow.
  lastEmailMessageId String?

  @@unique([sequenceId, entityType, entityId, enteredAt])
  @@index([status, nextActionAt])
  @@index([entityType, entityId])
}

// ============ LEAD LISTS (Pardot-style audience lists) ============
// Static or rules-driven sets of leads. Used as the audience for Mass Email
// and as the target of add_to_list / remove_from_list sequence steps.
model LeadList {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  // Optional auto-refresh criteria, same AST shape as ValidationRule. When
  // non-empty the cron rebuilds membership periodically.
  criteria    Json?
  isActive    Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation("LeadListCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members LeadListMember[]
}

model LeadListMember {
  id      String   @id @default(cuid())
  listId  String
  list    LeadList @relation(fields: [listId], references: [id], onDelete: Cascade)
  leadId  String
  lead    Lead     @relation("LeadListsForLead", fields: [leadId], references: [id], onDelete: Cascade)
  addedAt DateTime @default(now())
  // manual | criteria | sequence
  source  String   @default("manual")

  @@unique([listId, leadId])
  @@index([listId])
}
