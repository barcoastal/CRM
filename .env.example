DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"
FIVE9_GOOGLE_CLIENT_ID=""
FIVE9_GOOGLE_HOSTED_DOMAIN=""
LEAD_INGEST_API_KEY="your-secret-key-here"

# AI outbound dialer (Retell uses Twilio numbers imported in its dashboard)
RETELL_API_KEY="key_with_webhook_badge"
AI_DIALER_COMPANY_NAME="Your Company"
AI_DIALER_TRANSFER_NUMBER="+12125551234"
AI_DIALER_TOOL_SECRET="generate-a-long-random-secret"

# Encrypts Google refresh tokens stored in IntegrationCredential.config.
# Use a separate random value in production; changing it requires reconnecting Google.
INTEGRATION_ENCRYPTION_KEY="generate-a-long-random-secret"
GOOGLE_CALENDAR_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CALENDAR_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/api/integrations/google-calendar/callback"

# Audited built-in automation mappings (users must be active).
WEB_LEAD_OWNER_EMAIL=ssweet@coastaldebt.com
CONTRACT_CADENCE_OWNER_EMAIL=ferron@coastaldebt.com
DISABLE_WEB_LEAD_ROUTING=false
# Enable only after the Welcome Call and Contract Signed steps are verified.
ENABLE_OPPORTUNITY_CADENCES=false
# Optional external cadence cron access; the in-process scheduler runs every minute.
CADENCE_RUN_SECRET=

# Native human-agent call center. Leave at five9 until the Twilio pilot is validated.
CRM_DIALER_MODE="five9"
CALL_CENTER_PUBLIC_URL="https://your-crm.example.com"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_API_KEY=""
TWILIO_API_SECRET=""
TWILIO_TWIML_APP_SID=""
TWILIO_OUTBOUND_NUMBER=""
CALL_CENTER_RECORD_CALLS="false"
# Match the Twilio account's approved Calls Per Second (1 by default).
CALL_CENTER_CALLS_PER_SECOND="1"
# Used only if a cold-list answer cannot reach an agent. No sales message.
CALL_CENTER_COMPANY_NAME=""
CALL_CENTER_CALLBACK_NUMBER=""
