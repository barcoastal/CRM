    <assignments>
        <description>Assigning the current case owner from User/Group to L1 queue</description>
        <name>Assign_Case_Owner_to_L1_Queue</name>
        <label>Assign Case Owner to L1 Queue</label>
        <locationX>842</locationX>
        <locationY>518</locationY>
        <assignmentItems>
            <assignToReference>Get_Case_Record.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_L1_Queue.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Get_Case_Record.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Escalated</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Case_Owner_to_Escalation_Queue</targetReference>
        </connector>
    </assignments>
