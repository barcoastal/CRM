    <decisions>
        <description>Check whether the case is assigned to L1, L2, or L3 queue.</description>
        <name>Is_Case_assigned_to_Queue</name>
        <label>Is Case assigned to Queue?</label>
        <locationX>578</locationX>
        <locationY>278</locationY>
        <defaultConnectorLabel>False - Is Case assigned to Queue</defaultConnectorLabel>
        <rules>
            <name>True_L1_Is_Case_assigned_to_Queue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case_Record.Owner:Group.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>L1</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_L2_Queue</targetReference>
            </connector>
            <label>True - L1 - Is Case assigned to Queue</label>
        </rules>
        <rules>
            <name>True_L2_Is_Case_assigned_to_Queue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case_Record.Owner:Group.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>L2</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_L3_Queue</targetReference>
            </connector>
            <label>True - L2 - Is Case assigned to Queue</label>
        </rules>
        <rules>
            <name>True_L3_Is_Case_assigned_to_Queue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case_Record.Owner:Group.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>L3</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>WarningScreen</targetReference>
            </connector>
            <label>True - L3 - Is Case assigned to Queue</label>
        </rules>
        <rules>
            <name>False_User_Is_Case_assigned_to_Queue</name>
            <conditionLogic>1 OR (2 AND 3 AND 4)</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case_Record.Owner:Group.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case_Record.Owner:Group.DeveloperName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>L1</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case_Record.Owner:Group.DeveloperName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>L2</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case_Record.Owner:Group.DeveloperName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>L3</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_L1_Queue</targetReference>
            </connector>
            <label>False - User - Is Case assigned to Queue</label>
        </rules>
    </decisions>
    <description>Screen flow to escalate the case on the button click to different levels of queue.</description>
    <environments>Default</environments>
    <formulas>
        <description>Get the updated queue name</description>
        <name>QueueName</name>
        <dataType>String</dataType>
        <expression>IF ({!False_User_Is_Case_assigned_to_Queue}, &apos;L1&apos;, IF ({!True_L1_Is_Case_assigned_to_Queue}, &apos;L2&apos;, IF({!True_L2_Is_Case_assigned_to_Queue}, &apos;L3&apos;, &apos;&apos;)))</expression>
    </formulas>
