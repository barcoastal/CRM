    <textTemplates>
        <description>email body to notify owner when new case is created.</description>
        <name>NewCaseEmailBody</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Dear &lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;{!CurrentOwnerName}&lt;/span&gt;,&lt;/p&gt;&lt;p&gt;A new case has been created and assigned to you with the following details:&lt;/p&gt;&lt;p&gt;Case Number: &lt;em&gt;{!$Record.CaseNumber}&lt;/em&gt;&lt;/p&gt;&lt;p&gt;Subject: &lt;em&gt;{!$Record.Subject}&lt;/em&gt;&lt;/p&gt;&lt;p&gt;Description: &lt;em&gt;{!$Record.Description}&lt;/em&gt;&lt;/p&gt;&lt;p&gt;Please click &lt;a href=&quot;{!CaseDetailLink}&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;here&lt;/a&gt; to review this case record and take any necessary actions.&lt;/p&gt;&lt;p&gt;Thank you,&lt;/p&gt;&lt;p&gt;{!$Organization.Name}&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <description>Body of the email send to new owner and old owner when there is a change in owner.</description>
        <name>OwnerChangeEmailBody</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Hello,&lt;/p&gt;&lt;p&gt;The owner of case {!$Record.CaseNumber} has been changed from &lt;em style=&quot;background-color: rgb(255, 255, 255); color: rgb(68, 68, 68);&quot;&gt;{!PriorOwnerName}&lt;/em&gt; to &lt;em style=&quot;background-color: rgb(255, 255, 255); color: rgb(68, 68, 68);&quot;&gt;{!CurrentOwnerName}&lt;/em&gt;. Case needs to be resolved within our standard service levels.&lt;/p&gt;&lt;p&gt;Please click &lt;a href=&quot;{!CaseDetailLink}&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;here&lt;/a&gt; to view this case record &lt;span style=&quot;color: rgb(68, 68, 68); background-color: rgb(255, 255, 255);&quot;&gt;and take any necessary actions.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Thank you,&lt;/p&gt;&lt;p&gt;{!$Organization.Name}&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <description>Body of the email to send notification whenever there is a status change in the case.</description>
        <name>StatusChangeEmailBody</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Dear {!CurrentOwnerName},&lt;/p&gt;&lt;p&gt;We wanted to let you know that the status of your case ({!$Record.CaseNumber}) has been updated.&lt;/p&gt;&lt;p&gt;The new status is: &lt;strong&gt;{!$Record.Status}&lt;/strong&gt;.&lt;/p&gt;&lt;p&gt;Please click &lt;a href=&quot;{!CaseDetailLink}&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;here&lt;/a&gt; to view this case record &lt;span style=&quot;color: rgb(68, 68, 68); background-color: rgb(255, 255, 255);&quot;&gt;and take any necessary actions&lt;/span&gt;.&lt;/p&gt;&lt;p&gt;Thank you,&lt;/p&gt;&lt;p&gt;{!$Organization.Name}&lt;/p&gt;</text>
    </textTemplates>
