                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Email_Addresses_1</targetReference>
            </connector>
            <label>True - Is Status Changed</label>
        </rules>
    </decisions>
    <description>Case Record Triggered Flow to execute all the logics for the case object on after create and after update events.</description>
    <environments>Default</environments>
    <formulas>
        <description>formula to generate the contact lightning record detail link</description>
        <name>CaseDetailLink</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_260}, FIND(&apos;/services&apos;, {!$Api.Partner_Server_URL_260})) &amp; {!$Record.Id}</expression>
    </formulas>
    <formulas>
        <description>Formula to generate the owner email based on whether the owner is user or queue.</description>
        <name>CurrentOwnerEmail</name>
        <dataType>String</dataType>
        <expression>IF( NOT( ISBLANK( {!$Record.Owner:User.Id} ) ), {!$Record.Owner:User.Email}, IF( NOT( ISBLANK( {!$Record.Owner:Group.Id} ) ) &amp;&amp; NOT( ISBLANK({!$Record.Owner:Group.Email}) ), {!$Record.Owner:Group.Email}, NULL))</expression>
    </formulas>
    <formulas>
        <description>Formula to generate owner name based on whether the owner is user or queue</description>
        <name>CurrentOwnerName</name>
        <dataType>String</dataType>
        <expression>IF( NOT( ISBLANK( {!$Record.Owner:User.Id} ) ), {!$Record.Owner:User.FirstName}&amp;&apos; &apos;&amp;{!$Record.Owner:User.LastName}, IF( NOT( ISBLANK( {!$Record.Owner:Group.Id} ) ), {!$Record.Owner:Group.Name}, &apos;&apos;))</expression>
    </formulas>
    <formulas>
        <description>Check whether the current record is new or not.</description>
        <name>isNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>NewCaseEmailSubject</name>
        <dataType>String</dataType>
        <expression>&apos;New Case Created - &apos;&amp;{!$Record.CaseNumber}</expression>
    </formulas>
    <formulas>
        <description>Subject of the email to send to old owner and new owner when there is a change in the owner.</description>
        <name>OwnerChangeEmailSubject</name>
        <dataType>String</dataType>
        <expression>&apos;Case Owner Changed - &apos;&amp;{!$Record.CaseNumber}</expression>
    </formulas>
    <formulas>
        <description>Formula to generate the prior owner email based on whether the owner is user or queue.</description>
        <name>PriorOwnerEmail</name>
        <dataType>String</dataType>
        <expression>IF( NOT( ISBLANK( {!$Record__Prior.Owner:User.Id} ) ), {!$Record__Prior.Owner:User.Email}, IF( NOT( ISBLANK( {!$Record__Prior.Owner:Group.Id} ) ) &amp;&amp; NOT( ISBLANK({!$Record__Prior.Owner:Group.Email}) ), {!$Record__Prior.Owner:Group.Email}, NULL))</expression>
    </formulas>
    <formulas>
        <description>Formula to generate previous owner name based on whether the owner is user or queue</description>
        <name>PriorOwnerName</name>
        <dataType>String</dataType>
        <expression>IF( NOT( ISBLANK( {!$Record__Prior.Owner:User.Id} ) ), {!$Record__Prior.Owner:User.FirstName}&amp;&apos; &apos;&amp;{!$Record__Prior.Owner:User.LastName}, IF( NOT( ISBLANK( {!$Record__Prior.Owner:Group.Id} ) ), {!$Record__Prior.Owner:Group.Name}, &apos;&apos;))</expression>
    </formulas>
    <formulas>
        <description>Subject of the email send to owner when there is a change in the status.</description>
        <name>StatusChangeEmailSubject</name>
        <dataType>String</dataType>
        <expression>{!$Record.CaseNumber} &amp;&apos; - Case status has been changed&apos;</expression>
    </formulas>
