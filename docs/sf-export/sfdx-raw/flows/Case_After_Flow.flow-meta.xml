    <decisions>
        <description>Check whether the current case record triggered the flow is NEW.</description>
        <name>Is_New_Case</name>
        <label>Is New Case?</label>
        <locationX>182</locationX>
        <locationY>335</locationY>
        <defaultConnector>
            <targetReference>Is_Owner_Changed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>False - Is New Case</defaultConnectorLabel>
        <rules>
            <name>True_Is_New_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CurrentOwnerEmail</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Email_Addresses</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>True - Is New Case</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check whether the owner is changed or not</description>
        <name>Is_Owner_Changed</name>
        <label>Is Owner Changed?</label>
        <locationX>182</locationX>
        <locationY>791</locationY>
        <defaultConnector>
            <targetReference>Is_Status_Changed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>False - Is Owner Changed</defaultConnectorLabel>
        <rules>
            <name>True_Is_Owner_Changed</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OwnerId</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CurrentOwnerEmail</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>PriorOwnerEmail</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Email_Addresses_0</targetReference>
            </connector>
            <label>True - Is Owner Changed</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check whether the case status is changed or not</description>
        <name>Is_Status_Changed</name>
