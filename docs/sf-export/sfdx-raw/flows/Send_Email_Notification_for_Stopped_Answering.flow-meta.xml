        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <stringValue>&lt;p&gt;&lt;span style=&quot;font-family: Lora;&quot;&gt;Dear &lt;/span&gt;&lt;span style=&quot;font-family: Lora; background-color: rgb(255, 255, 255);&quot;&gt;{!Get_Related_Contact.Name}&lt;/span&gt;&lt;span style=&quot;font-family: Lora;&quot;&gt;,&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Lora;&quot;&gt;As outlined in our contract, initiating a stop payment constitutes a breach, leading to immediate termination of the program. This action signals to both the bank and us that you no longer wish to continue with our services. Effective communication with us is crucial, and bypassing this step by stopping payments suggests a lack of commitment to the program.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Lora;&quot;&gt;You engaged our services to manage your MCA debt, but halting payments means you are not fulfilling your part of the agreement. Attached is a copy of your contract, which states on Page 3, Provision 5, that we may terminate the contract with written notice under these circumstances.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Lora;&quot;&gt;Unfortunately, we must proceed with closing your account and terminating our services as per the contract terms.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Lora;&quot;&gt;If you have any questions or need further clarification, please feel free to reach out.&lt;/span&gt;&lt;/p&gt;</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>sendRichBody</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
        <offset>0</offset>
    </actionCalls>
