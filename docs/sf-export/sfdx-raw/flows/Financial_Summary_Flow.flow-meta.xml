    <formulas>
        <name>NetProfitQualified</name>
        <dataType>Boolean</dataType>
        <expression>IF(
	OR(
		AND(({!$Record.Net_Profit__c} &gt; 0), ISPICKVAL({!Get_Opportunity.StageName}, &apos;Agreements Received&apos;)),
		AND({!Get_Account.Qualified_Financial__c},({!$Record.Net_Profit__c} &gt; 0))
	),
	TRUE,
	FALSE)</expression>
    </formulas>
