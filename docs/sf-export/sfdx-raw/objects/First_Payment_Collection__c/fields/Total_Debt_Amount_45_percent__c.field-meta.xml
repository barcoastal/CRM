  ISBLANK( Total_Debt_Amount__c ),
  0,
  Total_Debt_Amount__c * 0.45
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>45% of Total Debt Amount</label>
